Процедура СоздатьПарковку(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда
		Предупреждение("Сначала сохраните площадку!");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Площадка", Объект.Ссылка);
	
	ОткрытьФорму("Обработка.АвтоСозданиеПоРазмерамПарковки.Форма.Форма", 
				ПараметрыФормы);
	
КонецПроцедуры