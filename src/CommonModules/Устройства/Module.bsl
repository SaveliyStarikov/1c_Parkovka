Функция Подключить(Устройство) Экспорт
	
	Результат = Истина;
	Если Устройство.Тип = Перечисления.ТипыУстройств.Камера Тогда
		Камеры = Новый Массив;
		Камеры.Добавить(Устройство);
		Результат = СтрокаПоляHTTPВидеоКамер(Камеры, 1);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

