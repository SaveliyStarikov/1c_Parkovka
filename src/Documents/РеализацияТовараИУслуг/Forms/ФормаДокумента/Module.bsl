
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	ПересчитатьИтоги();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыУслуги

&НаКлиенте
Процедура УслугиУслугаПриИзменении(Элемент)
	
	СтруктураСтроки = Новый Структура("Услуга,Объект, Цена");
	ЗаполнитьЗначенияСвойств(СтруктураСтроки, Элементы.Услуги.ТекущиеДанные);
	ЗаполнитьЦену(СтруктураСтроки);
	ЗаполнитьЗначенияСвойств(Элементы.Услуги.ТекущиеДанные,СтруктураСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиЦенаПриИзменении(Элемент)
	ПересчитатьСтроку(Элементы.Услуги.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура УслугиКоличествоПриИзменении(Элемент)
	ПересчитатьСтроку(Элементы.Услуги.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура УслугиОбъектПриИзменении(Элемент)
	
	СтруктураСтроки = Новый Структура("Услуга,Объект, Цена");
	ЗаполнитьЗначенияСвойств(СтруктураСтроки, Элементы.Услуги.ТекущиеДанные);
	ЗаполнитьЦену(СтруктураСтроки);
	ЗаполнитьЗначенияСвойств(Элементы.Услуги.ТекущиеДанные,СтруктураСтроки);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Печать(Команда)
	ТабДок = СформироватьПечатнуюФормуНаСервере();
	Если ТабДок <> Неопределено Тогда
		ТабДок.Показать("Акт выполненных работ №" + Объект.Номер);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьЦену(СтруктураСтроки)

	СтруктураСтроки.Цена = РегистрыСведений.ЦеныУслуг.ЦенаУслуги(СтруктураСтроки.Услуга, СтруктураСтроки.Объект,
		Объект.Дата);

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтроку(Строка)
	Строка.Сумма = Строка.Количество * Строка.Цена;
	ПересчитатьИтоги();
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтоги()
	Объект.Сумма = Объект.Услуги.Итог("Сумма");
КонецПроцедуры

&НаСервере
Функция СформироватьПечатнуюФормуНаСервере()

	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = ДокументОбъект.ПолучитьМакет("АктВыполненыхРабот");
	Если Макет = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Макет печатной формы не найден!");
		Возврат Неопределено;
	КонецЕсли;
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Номер = ДокументОбъект.Номер;
	ОбластьШапка.Параметры.Дата = ДокументОбъект.Дата;
	ТабДок.Вывести(ОбластьШапка);
	
	ОбластьОсновные = Макет.ПолучитьОбласть("ОсновныеДанные");
	ОбластьОсновные.Параметры.Организация = ДокументОбъект.Организация;
	ОбластьОсновные.Параметры.Контрагент = ДокументОбъект.Контрагент;
	ТабДок.Вывести(ОбластьОсновные);
	
	ОбластьТабЧасть = Макет.ПолучитьОбласть("ТабЧасть");
	Для каждого СтрокаТЧ Из ДокументОбъект.Услуги Цикл
		ОбластьТабЧасть.Параметры.Услуга = СтрокаТЧ.Услуга;
		ОбластьТабЧасть.Параметры.Количество = СтрокаТЧ.Количество;
		ОбластьТабЧасть.Параметры.Сумма = СтрокаТЧ.Сумма;
		ТабДок.Вывести(ОбластьТабЧасть);
	КонецЦикла;
	
	ОбщаяСумма = 0;
	СуммаКоличество = 0;
	Для каждого СтрокаТЧ Из ДокументОбъект.Услуги Цикл
		ОбщаяСумма = ОбщаяСумма + СтрокаТЧ.Сумма;
		СуммаКоличество = СуммаКоличество + СтрокаТЧ.Количество;
	КонецЦикла;
	
	ОбластьСумма = Макет.ПолучитьОбласть("Сумма");
	ОбластьСумма.Параметры.ОбщаяСумма = ОбщаяСумма;
	ОбластьСумма.Параметры.СуммаКоличество = СуммаКоличество;
	ТабДок.Вывести(ОбластьСумма);
	
	ОбластьШапкаЗаказчик = Макет.ПолучитьОбласть("ШапкаЗаказчик");
	ТабДок.Вывести(ОбластьШапкаЗаказчик);
	
	ОбластьЛица = Макет.ПолучитьОбласть("Лица");
	ОбластьЛица.Параметры.Организация = ДокументОбъект.Организация;
	ОбластьЛица.Параметры.Ответственный = ДокументОбъект.Ответственный;
	ОбластьЛица.Параметры.Контрагент = ДокументОбъект.Контрагент;
	ТабДок.Вывести(ОбластьЛица);
	
	Возврат ТабДок;
КонецФункции

#КонецОбласти
